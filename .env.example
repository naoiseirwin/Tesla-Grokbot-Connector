# Copy the values you need into the process environment, into the file named
# by TESLA_MCP_CONFIG, or into <data dir>/config.env (mode 600). On a Grok Bot
# computer the data directory defaults to /workspace/.tesla-mcp when that
# directory exists. A .env file in the current working directory is not read.
# Do not commit real values. Do not paste the client secret, token key, or
# tokens into chat.

# From https://developer.tesla.com — your own app. Name it something that
# does not sound like an official Tesla product, for example "GrokBot Vehicle Bridge".
TESLA_CLIENT_ID=your_client_id_here
TESLA_CLIENT_SECRET=your_client_secret_here

# 32-byte key, urlsafe base64. Hold this in a secret or an env var.
# Do not put it in the repo and do not write it next to a plaintext token.
# Generate on a private terminal: tesla-mcp gen-key
TESLA_TOKEN_KEY=your_base64_token_key_here

# na (North America and Asia-Pacific except China), eu, or cn.
TESLA_REGION=na

# Optional overrides. Leave unset unless Tesla gives you a different host.
# Each one must be the exact https endpoint for that setting and TESLA_REGION,
# port 443 only. tesla.cn is only the China Fleet host, and only when the
# region is cn. Token and sign-in stay on tesla.com in every region. Other
# hosts, other ports, http, and userinfo are refused at startup.
# TESLA_FLEET_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
# TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
# TESLA_AUTH_URL=https://auth.tesla.com/oauth2/v3/authorize
# TESLA_REDIRECT_URI=http://localhost:8765/callback

# Where tokens and history live. Default on a Grok Bot computer:
# /workspace/.tesla-mcp
# TESLA_MCP_DATA_DIR=/workspace/.tesla-mcp
# TESLA_MCP_CONFIG=/workspace/.tesla-mcp/config.env

# Opt in only if you want them. Both default off.
# TESLA_ENABLE_LOCATION=false
# vehicle_charging_cmds also allows charge start/stop at Tesla's API.
# This server still exposes no charge control. Leave this false unless you
# have decided the broader grant is acceptable.
# TESLA_ENABLE_CHARGING_HISTORY=false

# Wake budget. Wakes are billed (about $0.02 each) and Tesla caps them at 3/minute.
# The per-minute cap cannot be raised above 3. TESLA_WAKE_DAILY_CAP cannot be
# set above 10. TESLA_WAKE_MIN_INTERVAL_SECONDS cannot be set above 86400.
# TESLA_WAKE_DAILY_CAP=3
# TESLA_WAKE_MIN_INTERVAL_SECONDS=1800
# TESLA_WAKE_PER_MINUTE=3
# Command and wake caps count a rolling 24-hour window, not the calendar day.
# TESLA_TIMEZONE still applies to reports. Use an IANA name.
# TESLA_TIMEZONE=America/New_York

# Used by `tesla-mcp poll --loop`. Values below 1 hour are raised to 1 hour.
# A Grok Bot routine should call `tesla-mcp poll` once every 1–2 hours instead.
# TESLA_POLL_INTERVAL_HOURS=2

# Optional commands connector (tesla-commands-mcp). Off by default.
# tesla-mcp does not read the variables below. An invalid value cannot stop it.
# See docs/COMMANDS.md. Caps count the last 24 hours. The numbers below are
# the maximum in that window, not a calendar day.
# TESLA_ENABLE_COMMANDS=false
# Dry-run turns off only for false, 0, no, or off.
# A blank, whitespace, or any other value stays in dry-run.
# TESLA_COMMANDS_DRY_RUN=true
# TESLA_COMMANDS_ALLOWLIST=
# TESLA_COMMANDS_DAILY_CAP=10
# TESLA_COMMANDS_PER_COMMAND_DAILY_CAP=3
# TESLA_COMMAND_PROXY_URL=https://127.0.0.1:4443
# TESLA_COMMAND_PROXY_CA=
# Skip TLS checking only for a proxy on this computer. A remote URL with this
# flag is refused. When it is on, the commands server logs a startup warning.
# TESLA_COMMAND_PROXY_INSECURE=false
# TESLA_COMMAND_PROXY_ALLOW_REMOTE=false
