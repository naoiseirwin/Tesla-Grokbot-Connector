# Copy the values you need into the process environment or into
# /workspace/.tesla-mcp/config.env (mode 600). Do not commit real values.
# Do not paste the client secret, token key, or tokens into chat.

# From https://developer.tesla.com — your own app. Name it something that
# does not sound like an official Tesla product, for example "GrokBot Vehicle Bridge".
TESLA_CLIENT_ID=your_client_id_here
TESLA_CLIENT_SECRET=your_client_secret_here

# 32-byte key, urlsafe base64. Hold this in a secret or an env var.
# Do not put it in the repo and do not write it next to a plaintext token.
# Generate on a private terminal: tesla-mcp gen-key
TESLA_TOKEN_KEY=your_base64_token_key_here

# na (North America and Asia-Pacific except China), eu, or cn.
TESLA_REGION=na

# Optional overrides. Leave unset unless Tesla gives you a different host.
# TESLA_FLEET_API_BASE=https://fleet-api.prd.na.vn.cloud.tesla.com
# TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
# TESLA_AUTH_URL=https://auth.tesla.com/oauth2/v3/authorize
# TESLA_REDIRECT_URI=http://localhost:8765/callback

# Where tokens and history live. Default on a Grok Bot computer:
# /workspace/.tesla-mcp
# TESLA_MCP_DATA_DIR=/workspace/.tesla-mcp
# TESLA_MCP_CONFIG=/workspace/.tesla-mcp/config.env

# Opt in only if you want them. Both default off.
# TESLA_ENABLE_LOCATION=false
# vehicle_charging_cmds also allows charge start/stop at Tesla's API.
# This server still exposes no charge control. Leave this false unless you
# have decided the broader grant is acceptable.
# TESLA_ENABLE_CHARGING_HISTORY=false

# Wake budget. Wakes are billed (about $0.02 each) and Tesla caps them at 3/minute.
# The per-minute cap cannot be raised above 3.
# TESLA_WAKE_DAILY_CAP=3
# TESLA_WAKE_MIN_INTERVAL_SECONDS=1800
# TESLA_WAKE_PER_MINUTE=3
# TESLA_TIMEZONE=UTC

# Used by `tesla-mcp poll --loop`. Values below 1 hour are raised to 1 hour.
# A Grok Bot routine should call `tesla-mcp poll` once every 1–2 hours instead.
# TESLA_POLL_INTERVAL_HOURS=2
